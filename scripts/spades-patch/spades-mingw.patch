@@ -25,6 +25,16 @@ add_executable(spades-ionhammer
                gamma_poisson_model.cpp
                normal_quality_model.cpp)
 
+# Windows/MinGW (GCC) port fix: IonHammer's HKMer (homopolymer k-mer) path stores the 1-byte
+# HomopolymerRun union element type through the type-punning adt::array_vector / KMerVector proxy
+# machinery (memcpy stores read back via HomopolymerRun* and via the array_reference proxy). At
+# -O2/-O3 GCC's strict-aliasing assumptions let it reorder/elide those loads, corrupting ~1/3 of
+# k-mer records during the disk-split buffering: their bytes no longer hash to the bucket file they
+# live in, so the perfect-hash index cannot find them (seq_idx -> NOT_FOUND) and the corrector
+# segfaults. The regular-KMer (uint64 element) path is unaffected. -fno-strict-aliasing makes the
+# intentional type-punning well-defined and is the standard remedy for such code.
+target_compile_options(spades-ionhammer PRIVATE -fno-strict-aliasing)
+
 #add_executable(kmer_evaluator
 #               kmer_data.cpp
 #               kmer_evaluator.cpp
