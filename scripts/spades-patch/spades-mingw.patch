diff --git a/src/common/utils/memory_limit.cpp b/src/common/utils/memory_limit.cpp
index ee3155d..3d818a8 100644
--- a/src/common/utils/memory_limit.cpp
+++ b/src/common/utils/memory_limit.cpp
@@ -12,6 +12,96 @@
 #include "utils/verify.hpp"
 
 #include <cstring>
+#include <algorithm>
+
+#include "config.hpp"
+
+#ifdef SPADES_USE_JEMALLOC
+# include <jemalloc/jemalloc.h>
+#endif
+
+#ifdef _WIN32
+
+// Native Windows port: there is no RLIMIT_AS / getrusage, and the POSIX shims for them
+// return garbage (which made get_free_memory() report ~7e8 Gb and broke split-buffer sizing).
+// Use the real Win32 APIs instead.
+#ifndef NOMINMAX
+# define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+# define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <psapi.h>
+
+namespace utils {
+
+namespace { size_t g_mem_limit_bytes = 0; }
+
+void limit_memory(size_t limit) {
+    g_mem_limit_bytes = limit;
+
+    // Windows has no RLIMIT_AS. Enforce a best-effort hard cap with a Job Object so a runaway
+    // run cannot exhaust the whole machine (important on lab laptops). Nested jobs are allowed
+    // on Windows 8+, but if the process is already in a job that forbids nesting the assignment
+    // fails and we simply keep the soft (config) limit used for buffer sizing.
+    HANDLE job = CreateJobObjectA(NULL, NULL);
+    if (job) {
+        JOBOBJECT_EXTENDED_LIMIT_INFORMATION info;
+        memset(&info, 0, sizeof(info));
+        info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_PROCESS_MEMORY;
+        info.ProcessMemoryLimit = limit;
+        if (!SetInformationJobObject(job, JobObjectExtendedLimitInformation, &info, sizeof(info)) ||
+            !AssignProcessToJobObject(job, GetCurrentProcess())) {
+            CloseHandle(job);
+        }
+        // else: intentionally keep the job handle open for the lifetime of the process.
+    }
+
+    double GB = double(limit) / 1024 / 1024 / 1024;
+    INFO("Memory limit set to " << GB << " Gb");
+}
+
+size_t get_memory_limit() {
+    if (g_mem_limit_bytes)
+        return g_mem_limit_bytes;
+    MEMORYSTATUSEX ms;
+    ms.dwLength = sizeof(ms);
+    if (GlobalMemoryStatusEx(&ms))
+        return (size_t) ms.ullTotalPhys;
+    return 0;
+}
+
+size_t get_max_rss() {
+    PROCESS_MEMORY_COUNTERS pmc;
+    if (GetProcessMemoryInfo(GetCurrentProcess(), &pmc, sizeof(pmc)))
+        return (size_t) (pmc.PeakWorkingSetSize / 1024);  // KB, matches Linux ru_maxrss units
+    return 0;
+}
+
+size_t get_used_memory() {
+    PROCESS_MEMORY_COUNTERS pmc;
+    if (GetProcessMemoryInfo(GetCurrentProcess(), &pmc, sizeof(pmc)))
+        return (size_t) (pmc.WorkingSetSize / 1024);  // KB
+    return 0;
+}
+
+size_t get_free_memory() {
+    // Real available physical memory, capped by the configured limit minus current usage.
+    MEMORYSTATUSEX ms;
+    ms.dwLength = sizeof(ms);
+    size_t avail = GlobalMemoryStatusEx(&ms) ? (size_t) ms.ullAvailPhys : 0;
+    size_t limit = get_memory_limit();
+    size_t used  = get_used_memory() * 1024;  // bytes
+    size_t headroom = (limit > used) ? (limit - used) : 0;
+    if (!avail)    return headroom;
+    if (!headroom) return avail;
+    return std::min(avail, headroom);
+}
+
+}  // namespace utils
+
+#else  // ! _WIN32  -- original POSIX implementation
 
 #if __DARWIN || __DARWIN_UNIX03
 # include <mach/task.h>
