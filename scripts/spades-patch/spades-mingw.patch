+def py_gzip_file(reads_file):
+    # Portable gzip using Python's standard library (no external gzip/pigz binary).
+    # Mirrors "gzip -f": writes <file>.gz and removes the original. zlib releases the
+    # GIL during compression, so this still parallelizes under a thread pool.
+    import gzip as _gzip
+    import shutil as _shutil
+    with open(reads_file, "rb") as fin, _gzip.open(reads_file + ".gz", "wb", compresslevel=7) as fout:
+        _shutil.copyfileobj(fin, fout, 1024 * 1024)
+    os.remove(reads_file)
+    return None
