+	   full approximate filter as best-effort, never as exact. */
+	if (qf->metadata->noccupied_slots >= qf->metadata->nslots - (qf->metadata->nslots >> 4))
+		return false;
 	if (count == 1)
 		return insert1(qf, key, lock, spin);
 	else
